package templates

import (
  "fmt"
  "strings"
  "github.com/techmigos/mgp/internal/view"
  layouts "github.com/techmigos/mgp/web/templates/layouts"
)

templ Dashboard(data view.PageData) { @layouts.Base(data, DashboardContent(data)) }

templ DashboardContent(data view.PageData) {
  <div class="page-intro">
    <div><div class="section-kicker">LIVE OPERATIONS</div><h2>Good day, { data.UserName }</h2><p class="muted">Track material movement from preparation to controlled return.</p></div>
    <div class="live-pill"><span></span> Live server data</div>
  </div>
  <section class="stat-grid">
    @StatCard("Total Gate Passes", fmt.Sprint(data.Visible), "Visible to your role", "teal")
    @StatCard("Pending Approval", fmt.Sprint(data.Pending), "Awaiting issuing review", "amber")
    @StatCard("Returnable Pending", fmt.Sprint(data.PassedOut), "Currently outside gate", "blue")
    @StatCard("Overdue Returns", fmt.Sprint(data.Overdue), "Requires follow-up", "red")
    @StatCard("Non-Returnable Issued", fmt.Sprint(data.PassedOut), "Completed outbound", "green")
    @StatCard("Today’s Passes", fmt.Sprint(data.Visible), "Current register window", "purple")
  </section>
  <div class="two-column-grid">
    <section class="card"><div class="card-heading"><div><div class="section-kicker">WORKFLOW SNAPSHOT</div><h3>Pass lifecycle</h3></div><a class="text-link" href="/reports">View reports →</a></div><div class="workflow-steps"><div class="workflow-step done"><span>1</span><strong>Draft</strong><small>Prepare</small></div><div class="workflow-line"></div><div class="workflow-step active"><span>2</span><strong>Submitted</strong><small>Review queue</small></div><div class="workflow-line"></div><div class="workflow-step"><span>3</span><strong>Approved</strong><small>Issuing</small></div><div class="workflow-line"></div><div class="workflow-step"><span>4</span><strong>Pass-out</strong><small>Security</small></div></div></section>
    <section class="card"><div class="card-heading"><div><div class="section-kicker">QUICK ACTIONS</div><h3>Move work forward</h3></div></div><div class="quick-actions">
      if data.Role == "ADMIN" || data.Role == "INVENTORY" {
        <a class="quick-action" href="/gate-passes/new"><span>＋</span><div><strong>Create gate pass</strong><small>Start a controlled record</small></div>→</a>
      }
      <a class="quick-action" href="/gate-passes"><span>▤</span><div><strong>Open register</strong><small>Search and filter records</small></div>→</a>
      <a class="quick-action" href="/reports"><span>▥</span><div><strong>Run a report</strong><small>Export operational data</small></div>→</a>
    </div></section>
  </div>
  <section class="card"><div class="card-heading"><div><div class="section-kicker">RECENT RECORDS</div><h3>Recent gate passes</h3></div><a class="btn btn-secondary btn-sm" href="/gate-passes">Open full register</a></div>
    @PassTable(data.Passes)
  </section>
}

templ StatCard(label, value, note, tone string) {
  <article class={ "stat-card stat-" + tone }><div class="stat-icon">▦</div><div class="stat-value">{ value }</div><div class="stat-label">{ label }</div><div class="stat-note">{ note }</div></article>
}

templ PassTable(rows []view.PassRow) {
  if len(rows) == 0 {
    <div class="empty-state"><div>∅</div><strong>No gate passes yet</strong><p>Records created by your role will appear here.</p></div>
  } else {
    <div class="table-scroll"><table class="data-table"><thead><tr><th>Pass number</th><th>Date</th><th>Consignee</th><th>Type</th><th>Status</th><th></th></tr></thead><tbody>
      for _, row := range rows {
        <tr><td><a class="table-link" href={ templ.URL("/gate-passes/" + row.ID) }>{ row.PassNo }</a></td><td>{ row.PassDate }</td><td>{ row.Consignee }</td><td>{ humanPassType(row.PassType) }</td><td><span class={ "badge badge-" + statusTone(row.Status) }>{ humanStatus(row.Status) }</span></td><td><a class="btn btn-ghost btn-sm" href={ templ.URL("/gate-passes/" + row.ID) }>View</a></td></tr>
      }
    </tbody></table></div>
  }
}

func humanPassType(value string) string { if value == "NON_RETURNABLE" { return "Non-returnable" }; return "Returnable" }
func humanStatus(value string) string { return strings.Title(strings.ToLower(strings.ReplaceAll(value, "_", " "))) }
func statusTone(value string) string { switch value { case "APPROVED": return "green"; case "SUBMITTED": return "amber"; case "PASSED_OUT": return "blue"; case "RETURNED": return "teal"; case "NOT_APPROVED": return "red"; default: return "slate" } }
