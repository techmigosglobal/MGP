package templates

import (
  "fmt"
  "github.com/techmigos/mgp/internal/view"
  layouts "github.com/techmigos/mgp/web/templates/layouts"
)

templ GatePasses(data view.PageData) { @layouts.Base(data, GatePassesContent(data)) }

templ GatePassesContent(data view.PageData) {
  <div class="page-intro"><div><div class="section-kicker">CONTROLLED REGISTER</div><h2>Gate pass records</h2><p class="muted">Searchable, role-scoped records with an immutable workflow history.</p></div></div>
  <section class="card"><form class="filter-bar" method="get" action="/gate-passes"><div class="search-field"><span>⌕</span><input name="q" value={ data.Search } placeholder="Search pass number, consignee or project"/></div><select class="select" name="status"><option value="">All statuses</option><option value="DRAFT" selected?={ data.StatusFilter == "DRAFT" }>Draft</option><option value="SUBMITTED" selected?={ data.StatusFilter == "SUBMITTED" }>Submitted</option><option value="APPROVED" selected?={ data.StatusFilter == "APPROVED" }>Approved</option><option value="NOT_APPROVED" selected?={ data.StatusFilter == "NOT_APPROVED" }>Not approved</option><option value="PASSED_OUT" selected?={ data.StatusFilter == "PASSED_OUT" }>Passed out</option><option value="RETURNED" selected?={ data.StatusFilter == "RETURNED" }>Returned</option></select><select class="select" name="type"><option value="">All types</option><option value="RETURNABLE" selected?={ data.TypeFilter == "RETURNABLE" }>Returnable</option><option value="NON_RETURNABLE" selected?={ data.TypeFilter == "NON_RETURNABLE" }>Non-returnable</option></select><button class="btn btn-secondary" type="submit">Apply filters</button></form></section>
  <section class="card"><div class="card-heading"><div><div class="section-kicker">REGISTER</div><h3>{ fmt.Sprint(len(data.Passes)) } records in view</h3></div>
    if data.Role == "ADMIN" || data.Role == "INVENTORY" {
      <a class="btn btn-primary btn-sm" href="/gate-passes/new">＋ Create gate pass</a>
    }
  </div>@PassTable(data.Passes)</section>
}

templ NewGatePass(data view.NewPassData) { @layouts.Base(data.PageData, NewGatePassContent(data)) }

templ NewGatePassContent(data view.NewPassData) {
  <div class="page-intro"><div><div class="section-kicker">CONTROLLED CREATION</div><h2>New gate pass</h2><p class="muted">Complete the reference form. The server validates every field and allocates the official number transactionally.</p></div><a class="btn btn-secondary btn-sm" href="/gate-passes">← Back to records</a></div>
  <form class="form-stack" method="post" action="/gate-passes" x-data="gatePassForm()" novalidate>
    <input type="hidden" name="csrf_token" value={ data.CSRFToken }/><input type="hidden" name="revision_of" value={ data.RevisionOf }/>
    <section class="card form-section"><div class="form-section-heading"><span class="form-number">01</span><div><h3>Gate pass classification</h3><p>Choose how the material will be controlled.</p></div></div><div class="form-grid cols-4"><div class="field"><label for="pass_type">Gate pass type</label><select class="select" id="pass_type" name="pass_type" x-model="passType" required><option value="RETURNABLE">Returnable</option><option value="NON_RETURNABLE">Non-Returnable</option></select></div><div class="field"><label for="pass_date">Pass date</label><input class="input" id="pass_date" type="date" name="pass_date" value={ data.PassDate } required/></div><div class="field"><label for="copy_type">Copy type</label><select class="select" id="copy_type" name="copy_type"><option value="ORIGINAL">Original</option><option value="DUPLICATE">Duplicate</option><option value="TRIPLICATE">Triplicate</option></select></div><div class="field"><label>Pass number</label><div class="locked-field">Allocated on save</div></div></div></section>
    <section class="card form-section"><div class="form-section-heading"><span class="form-number">02</span><div><h3>Movement and consignee</h3><p>Identify the originating group and receiving party.</p></div></div><div class="form-grid cols-3"><div class="field"><label>Directorate / Group / Division</label><input class="input" name="directorate" value={ data.Directorate } required/></div><div class="field"><label>Project</label><input class="input" name="project" value={ data.Project } required/></div><div class="field"><label>Inventory number</label><input class="input" name="inventory_no" value={ data.InventoryNo }/></div><div class="field"><label>Inventory holder</label><input class="input" name="inventory_holder" value={ data.InventoryHolder }/></div><div class="field"><label>Consignee name</label><input class="input" name="consignee_name" value={ data.ConsigneeName } required list="consignee-options"/><datalist id="consignee-options"></datalist></div><div class="field"><label>Gate pass reference number</label><input class="input" name="reference_no" value={ data.ReferenceNo }/></div><div class="field span-2"><label>Consignee address</label><textarea class="textarea" name="consignee_address" rows="2">{ data.ConsigneeAddress }</textarea></div><div class="field"><label>Number of packages</label><input class="input" type="number" min="1" name="packages" value={ data.Packages } required/></div></div></section>
    <section class="card form-section"><div class="form-section-heading"><span class="form-number">03</span><div><h3>Material details</h3><p>Each row is stored as a historical snapshot of the issued material.</p></div><button class="btn btn-secondary btn-sm" type="button" x-on:click="addItem()">＋ Add material row</button></div><div class="items-table-wrap"><table class="items-table"><thead><tr><th>Item code</th><th>Item name</th><th>Category</th><th>Serial number</th><th>Batch / lot</th><th>U/M</th><th>Full / part</th><th>Qty</th><th>Description</th><th></th></tr></thead><tbody id="item-rows">@ItemRows(data.Items)</tbody></table></div></section>
    <section class="card form-section"><div class="form-section-heading"><span class="form-number">04</span><div><h3>Purpose and authority</h3><p>Provide the accountable issue context.</p></div></div><div class="form-grid cols-2"><div class="field"><label>Purpose of issue</label><textarea class="textarea" name="purpose" rows="3" required>{ data.Purpose }</textarea></div><div class="field"><label>Authority</label><textarea class="textarea" name="authority" rows="3" required>{ data.Authority }</textarea></div><div class="field"><label>Transport / vehicle number</label><input class="input" name="vehicle_no" value={ data.VehicleNo }/></div><div class="field"><label>Loaded in presence of</label><input class="input" name="loaded_in_presence_of" value={ data.LoadedInPresenceOf }/></div><div class="field"><label>Name of person carrying stores</label><input class="input" name="carrier_name" value={ data.CarrierName }/></div><div class="field"><label>Name and designation</label><input class="input" name="carrier_designation" value={ data.CarrierDesignation }/></div><div class="field" x-show="passType === 'RETURNABLE'"><label>Probable return date</label><input class="input" type="date" name="expected_return_date" value={ data.ExpectedReturnDate } x-bind:required="passType === 'RETURNABLE'"/></div><div class="field"><label>Remarks</label><textarea class="textarea" name="remarks" rows="2">{ data.Remarks }</textarea></div></div></section>
    <div class="form-footer"><a class="btn btn-secondary" href="/gate-passes">Cancel</a><button class="btn btn-primary" type="submit">Save draft and allocate number</button><button class="btn btn-primary" type="submit" name="submit_after_save" value="true">Save & submit for approval</button></div>
  </form>
}

func firstItem(items []view.PassFormItem) view.PassFormItem { if len(items) == 0 { return view.PassFormItem{Unit: "NOS", Quantity: "1", FullPart: "Full Item"} }; return items[0] }
func firstItemUnit(items []view.PassFormItem) string { item := firstItem(items); if item.Unit == "" { return "NOS" }; return item.Unit }
func firstItemQuantity(items []view.PassFormItem) string { item := firstItem(items); return itemQuantity(item) }
func itemUnit(item view.PassFormItem) string { if item.Unit == "" { return "NOS" }; return item.Unit }
func itemQuantity(item view.PassFormItem) string { if item.Quantity == "" { return "1" }; return item.Quantity }

templ ItemRows(items []view.PassFormItem) {
  if len(items) == 0 {
    @ItemRow(firstItem(items))
  } else {
    for _, item := range items {
      @ItemRow(item)
    }
  }
}

templ ItemRow(item view.PassFormItem) {
  <tr class="item-row"><td><input class="input" name="item_code[]" value={ item.Code }/></td><td><input class="input" name="item_name[]" value={ item.Name } required/></td><td><input class="input" name="category[]" value={ item.Category }/></td><td><input class="input" name="serial_no[]" value={ item.SerialNo }/></td><td><input class="input" name="batch_no[]" value={ item.BatchNo }/></td><td><input class="input" name="unit[]" value={ itemUnit(item) } required/></td><td><select class="select" name="full_part[]"><option selected?={ item.FullPart == "Full Item" }>Full Item</option><option selected?={ item.FullPart == "Part Item" }>Part Item</option></select></td><td><input class="input qty-input" type="number" min="0.001" step="0.001" name="quantity[]" value={ itemQuantity(item) } required/></td><td><input class="input" name="description[]" value={ item.Description }/></td><td><button class="row-remove" type="button" x-on:click="$el.closest('tr').remove()" aria-label="Remove material row">×</button></td></tr>
}

templ GatePassDetail(data view.DetailData) { @layouts.Base(data.PageData, GatePassDetailContent(data)) }

templ GatePassDetailContent(data view.DetailData) {
  <div class="page-intro"><div><div class="section-kicker">PASS RECORD</div><h2>{ data.Pass.PassNo }</h2><p class="muted">Created { data.Pass.PassDate } · { humanPassType(data.Pass.PassType) } · { data.Pass.CopyType }</p></div><div class="page-actions"><span class={ "badge badge-large badge-" + statusTone(data.Pass.Status) }>{ humanStatus(data.Pass.Status) }</span><a class="btn btn-secondary btn-sm" href={ templ.URL("/gate-passes/" + data.Pass.ID + "/pdf?draft=true") }>A4 preview</a>@OfficialPDFLink(data)</div></div>
  <div class="detail-grid"><section class="card"><div class="card-heading"><div><div class="section-kicker">MOVEMENT DETAILS</div><h3>Record snapshot</h3></div></div><dl class="detail-list"><div><dt>Directorate</dt><dd>{ data.Pass.Directorate }</dd></div><div><dt>Project</dt><dd>{ data.Pass.Project }</dd></div><div><dt>Inventory</dt><dd>{ data.Pass.InventoryNo } · { data.Pass.InventoryHolder }</dd></div><div><dt>Consignee</dt><dd>{ data.Pass.Consignee }<small>{ data.Pass.ConsigneeAddress }</small></dd></div><div><dt>Reference</dt><dd>{ data.Pass.ReferenceNo }</dd></div><div><dt>Packages</dt><dd>{ fmt.Sprint(data.Pass.Packages) }</dd></div><div><dt>Purpose</dt><dd>{ data.Pass.Purpose }</dd></div><div><dt>Authority</dt><dd>{ data.Pass.Authority }</dd></div><div><dt>Vehicle / carrier</dt><dd>{ data.Pass.VehicleNo } · { data.Pass.CarrierName }</dd></div><div><dt>Return</dt><dd>{ data.Pass.ExpectedReturnDate } → { data.Pass.ActualReturnDate }</dd></div><div><dt>Remarks</dt><dd>{ data.Pass.Remarks }</dd></div></dl></section><section class="card"><div class="card-heading"><div><div class="section-kicker">WORKFLOW CONTROL</div><h3>Available action</h3></div></div>@DetailActions(data)</section></div>
  <section class="card"><div class="card-heading"><div><div class="section-kicker">MATERIAL SNAPSHOT</div><h3>{ fmt.Sprint(len(data.Pass.Items)) } material lines</h3></div></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Code</th><th>Item</th><th>Category</th><th>Serial / batch</th><th>Full / part</th><th>U/M</th><th>Qty</th><th>Description</th></tr></thead><tbody>
    for _, item := range data.Pass.Items {
      <tr><td>{ item.Code }</td><td><strong>{ item.Name }</strong></td><td>{ item.Category }</td><td>{ item.SerialNo }<br/>{ item.BatchNo }</td><td>{ item.FullPart }</td><td>{ item.Unit }</td><td>{ item.Quantity }</td><td>{ item.Description }</td></tr>
    }
  </tbody></table></div></section>
  <section class="card approval-card"><div><div class="section-kicker">APPROVAL RECORD</div><h3>Internal electronic approval trail</h3></div><div class="approval-grid"><div><small>Created by</small><strong>{ data.Pass.CreatedByName }</strong></div><div><small>Approved by</small><strong>{ data.Pass.ApprovedByName }</strong></div><div><small>Security officer</small><strong>{ data.Pass.SecurityOfficerName }</strong></div><div><small>Returned by</small><strong>{ data.Pass.ReturnedByName }</strong></div><div><small>Security control</small><strong>{ data.Pass.SecurityControlNo }</strong></div></div><p class="muted small-copy">Approval records are internal electronic approvals and are not legally certified PKI signatures.</p></section>
}

templ OfficialPDFLink(data view.DetailData) {
  if data.Pass.Status == "APPROVED" || data.Pass.Status == "PASSED_OUT" || data.Pass.Status == "RETURNED" {
    <a class="btn btn-primary btn-sm" href={ templ.URL("/gate-passes/" + data.Pass.ID + "/pdf") }>Official PDF</a>
  }
}

templ DetailActions(data view.DetailData) {
  <div class="action-panel">
    if data.Pass.Status == "DRAFT" && (data.Role == "ADMIN" || data.Role == "INVENTORY") {
      <form method="post" action={ templ.URL("/gate-passes/" + data.Pass.ID + "/submit") }><input type="hidden" name="csrf_token" value={ data.CSRFToken }/><button class="btn btn-primary btn-wide" type="submit">Submit for approval</button></form>
    } else if data.Pass.Status == "SUBMITTED" && (data.Role == "ADMIN" || data.Role == "ISSUING") {
      <form method="post" action={ templ.URL("/gate-passes/" + data.Pass.ID + "/approve") }><input type="hidden" name="csrf_token" value={ data.CSRFToken }/><button class="btn btn-primary btn-wide" type="submit">Approve pass</button></form>
      <form method="post" action={ templ.URL("/gate-passes/" + data.Pass.ID + "/reject") }><input type="hidden" name="csrf_token" value={ data.CSRFToken }/><label class="field">Rejection reason<textarea class="textarea" name="reason" rows="3" required></textarea></label><button class="btn btn-danger btn-wide" type="submit">Reject with reason</button></form>
    } else if data.Pass.Status == "APPROVED" && (data.Role == "ADMIN" || data.Role == "SECURITY") {
      <form method="post" action={ templ.URL("/gate-passes/" + data.Pass.ID + "/pass-out") }><input type="hidden" name="csrf_token" value={ data.CSRFToken }/><label class="field">Security control number<input class="input" name="reason" required/></label><button class="btn btn-primary btn-wide" type="submit">Record pass-out</button></form>
    } else if data.Pass.Status == "PASSED_OUT" && data.Pass.PassType == "RETURNABLE" && (data.Role == "ADMIN" || data.Role == "SECURITY") {
      <form method="post" action={ templ.URL("/gate-passes/" + data.Pass.ID + "/return") }><input type="hidden" name="csrf_token" value={ data.CSRFToken }/><button class="btn btn-primary btn-wide" type="submit">Record material return</button></form>
    } else if data.Pass.Status == "NOT_APPROVED" && (data.Role == "ADMIN" || data.Role == "INVENTORY") {
      <a class="btn btn-primary btn-wide" href={ templ.URL("/gate-passes/new?revision=" + data.Pass.PassNo) }>Create revision</a>
    } else {
      <div class="empty-state compact"><strong>No action available</strong><p>Current role and record state do not permit a mutation.</p></div>
    }
    if data.Pass.RejectionReason != "" {
      <div class="alert alert-error"><strong>Rejection reason</strong><br/>{ data.Pass.RejectionReason }</div>
    }
  </div>
}
