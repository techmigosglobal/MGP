package templates

import (
  "fmt"
  "github.com/techmigos/mgp/internal/view"
  layouts "github.com/techmigos/mgp/web/templates/layouts"
)

templ Reports(data view.PageData) {
  @layouts.Base(data, ReportsContent(data))
}

templ ReportsContent(data view.PageData) {
  <section class="metric-grid"><article class="metric"><div class="metric-value">{ fmt.Sprint(data.Visible) }</div><div class="metric-label">Visible records</div></article><article class="metric"><div class="metric-value">{ fmt.Sprint(data.Pending) }</div><div class="metric-label">Awaiting approval</div></article><article class="metric"><div class="metric-value">{ fmt.Sprint(data.PassedOut) }</div><div class="metric-label">Outside gate</div></article><article class="metric"><div class="metric-value">{ fmt.Sprint(data.Overdue) }</div><div class="metric-label">Overdue returns</div></article></section>
  <section class="panel"><div class="toolbar"><div><h2>Operational report</h2><p class="panel-note">This register is calculated on the server and scoped to the signed-in role.</p></div><button class="button secondary" type="button" x-on:click="window.print()">Print report</button></div>@PassTable(data.Passes)</section>
}
