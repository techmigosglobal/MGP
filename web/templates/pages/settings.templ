package templates

import (
  "github.com/techmigos/mgp/internal/view"
  layouts "github.com/techmigos/mgp/web/templates/layouts"
)

templ Settings(data view.SettingsData) { @layouts.Base(data.PageData, SettingsContent(data)) }
templ SettingsContent(data view.SettingsData) {
  <div class="page-intro"><div><div class="section-kicker">ADMINISTRATION</div><h2>Settings</h2><p class="muted">Configure organization defaults used by operators and documents.</p></div></div>
  <section class="card"><div class="card-heading"><div><div class="section-kicker">ORGANIZATION</div><h3>Application and document defaults</h3></div></div><form class="form-grid cols-2" method="post" action="/settings"><input type="hidden" name="csrf_token" value={ data.CSRFToken }/><div class="field"><label>Application name</label><input class="input" name="app_title" value={ data.ApplicationName } required/></div><div class="field"><label>Organization name</label><input class="input" name="name" value={ data.OrganizationName } required/></div><div class="field span-2"><label>Organization address</label><textarea class="textarea" name="address" rows="3">{ data.OrganizationAddress }</textarea></div><div class="field"><label>Default directorate</label><input class="input" name="default_directorate" value={ data.DefaultDirectorate }/></div><div class="field"><label>Default project</label><input class="input" name="default_project" value={ data.DefaultProject }/></div><div class="field"><label>Default copy type</label><select class="select" name="default_copy"><option value="ORIGINAL">Original</option><option value="DUPLICATE">Duplicate</option><option value="TRIPLICATE">Triplicate</option></select></div><div class="field"><label>Session timeout (minutes)</label><input class="input" name="session_minutes" value={ data.SessionMinutes } inputmode="numeric"/></div><div class="field"><label>Manual pass-number policy</label><select class="select" name="allow_manual_pass_no"><option value="no">Database allocated only</option><option value="yes">Allow administrator override</option></select></div><div class="field"><label>Organization logo path</label><input class="input" name="logo" value={ data.Logo } placeholder="data/documents/logo.png"/></div><div class="form-footer span-2"><button class="btn btn-primary" type="submit">Save settings</button></div></form></section>
  <section class="card" id="backup"><div class="card-heading"><div><div class="section-kicker">OPERATIONS</div><h3>Backup and restore</h3><p class="muted">Use the offline deployment bundle backup scripts for PostgreSQL dumps, document archives, checksums, and restore verification.</p></div></div><div class="quick-actions"><div class="quick-action"><span>⇩</span><div><strong>Backup tooling</strong><small>Available in deploy/backup and the server-PC package</small></div></div><div class="quick-action"><span>✓</span><div><strong>Recovery target</strong><small>Daily backup · maximum recovery point 24 hours · monthly restore test</small></div></div></div></section>
}
