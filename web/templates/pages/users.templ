package templates

import (
  "github.com/techmigos/mgp/internal/view"
  layouts "github.com/techmigos/mgp/web/templates/layouts"
)

templ Users(data view.UsersData) {
  @layouts.Base(data.PageData, UsersContent(data))
}

templ UsersContent(data view.UsersData) {
  <section class="panel">
    <div class="toolbar"><div><div class="eyebrow accent">ACCESS CONTROL</div><h2>User master</h2><p class="panel-note">Application accounts are local, role-bound, and auditable.</p></div></div>
    <form class="form-grid compact-form" method="post" action="/users">
      <input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
      <label>Name<input name="name" required/></label>
      <label>Username<input name="username" pattern="[a-z][a-z0-9._-]{2,31}" maxlength="32" autocapitalize="none" required/></label>
      <label>Role<select name="role" required><option>INVENTORY</option><option>ISSUING</option><option>SECURITY</option><option>VIEWER</option><option>ADMIN</option></select></label>
      <label>Initial 6-digit PIN<input type="password" name="pin" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required/></label>
      <div class="form-actions"><button class="button" type="submit">Create account</button></div>
    </form>
  </section>
  <section class="panel"><div class="section-heading"><div><h2>Accounts</h2><p class="panel-note">Suspended accounts are denied at login and on every authenticated request. PINs are never displayed.</p></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Status</th><th>Actions</th></tr></thead><tbody>
    for _, user := range data.Users {
      <tr><td>{ user.Name }</td><td>{ user.Username }</td><td><span class="role-chip">{ user.Role }</span></td><td><span class="status-badge">{ user.Status }</span></td><td><div class="inline-actions"><form method="post" action={ templ.URL("/users/" + user.ID + "/status") }><input type="hidden" name="csrf_token" value={ data.CSRFToken }/><input type="hidden" name="status" value={ userStatusToggle(user.Status) }/><button class="button ghost small" type="submit">{ userStatusLabel(user.Status) }</button></form><form method="post" action={ templ.URL("/users/" + user.ID + "/reset-pin") }><input type="hidden" name="csrf_token" value={ data.CSRFToken }/><input class="small-input" name="pin" type="password" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="New 6-digit PIN" required/><button class="button ghost small" type="submit">Reset PIN</button></form></div></td></tr>
    }
  </tbody></table></div></section>
}

func userStatusToggle(status string) string { if status == "active" { return "suspended" }; return "active" }
func userStatusLabel(status string) string { if status == "active" { return "Suspend" }; return "Activate" }
